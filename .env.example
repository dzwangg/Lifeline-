# Copy to .env.local and fill in. Every key is optional: without Gemini the recap is the built-in template,
# without ElevenLabs there is no audio. Never commit real keys.
GEMINI_API_KEY=
# A model per feature, cheapest that does the job. Paid tier, $ per 1M tokens in/out (thinking billed as output):
# gemini-3.5-flash-lite 0.30/2.50, gemini-3-flash-preview 0.50/3.00. A recap or chat answer costs about $0.001, a card
# draft about $0.005 (twice that with its retry). On the free tier, Flash models get 20 requests a day and Flash-Lite 500.
# The recaps and the resident chat take a Flash-Lite that accepts minimal thinking; cards need the stronger Flash.
# A feature left blank uses GEMINI_MODEL, then these same defaults.
GEMINI_MODEL_NARRATION=gemini-3.5-flash-lite
GEMINI_MODEL_CHAT=gemini-3.5-flash-lite
GEMINI_MODEL_CARDS=gemini-3-flash-preview
GEMINI_MODEL=
# Optional: when a model's daily quota is spent, the next model in this comma-separated list is tried once (the first, for
# a model not in it). Defaults to gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
# Optional: defaults to minimal (1.5s vs 12-19s at the model's default, and fewer billed thinking tokens). A model that
# rejects minimal is retried at low, then at its default.
GEMINI_THINKING_LEVEL=
# Optional: Gemini calls a server instance makes per UTC day, all models together (default 300; 0 turns Gemini off). Past
# it, replies come from caches and templates and say "AI responses paused for today". Each call logs its tokens and
# estimated cost. Per instance: N warm instances can each spend this many.
GEMINI_DAILY_CALL_CAP=
# Signs the cards /api/policies drafts, so /api/narration can trust their text when a browser sends them back. Any long
# random string (openssl rand -hex 32); without it player cards are narrated by the template only.
CARD_SIGNING_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: defaults to eleven_flash_v2_5 (ElevenLabs' lowest-latency model)
ELEVENLABS_MODEL=
# Optional, for npm run pregen:demo: it stops before calling ElevenLabs if its clips would take more characters than
# this. Defaults to 10000 (ElevenLabs' free month).
MAX_TTS_CHARS=
# 1 = never call Gemini or ElevenLabs; serve demo-audio/ clips or the template
DEMO_MODE=
